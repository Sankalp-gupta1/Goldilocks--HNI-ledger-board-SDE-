# Optional local configuration. The app reads process environment variables.
# .env files are NOT loaded automatically. Never commit your real .env.
HNI_DATA_DIR=./data
HNI_DB_PATH=./data/hni_ledger.db
HOST=127.0.0.1
PORT=8082
# APP_ENV=production requires HTTPS and starts Gunicorn.
# On Render: use /var/data only after attaching a persistent disk there.
